# ===========================================
# Omnilog (Omnilog) - Environment Configuration
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=postgresql://Omnilog:Omnilog123@postgres:5432/Omnilog?sslmode=disable

# For local development (without Docker):
# DATABASE_URL=postgresql://Omnilog:Omnilog123@localhost:5432/Omnilog?sslmode=disable

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=change-this-to-a-very-strong-random-secret-key-in-production

# ===========================================
# EMAIL / SMTP CONFIGURATION
# ===========================================
# Gmail Example (use App Password, not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# SendGrid Example:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_EMAIL=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ===========================================
# FRONTEND URL
# ===========================================
FRONTEND_URL=http://localhost

# For development:
# FRONTEND_URL=http://localhost:5173

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
PORT=8080

# ===========================================
# BOOTSTRAP CONFIGURATION
# ===========================================
# Allow creating admin even if users already exist (useful for dev/testing)
ALLOW_BOOTSTRAP_OVERRIDE=true

# For production, set to false:
# ALLOW_BOOTSTRAP_OVERRIDE=false

# ===========================================
# RATE LIMITING (Optional)
# ===========================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# ===========================================
# FILE UPLOADS (Optional)
# ===========================================
# MAX_UPLOAD_SIZE_MB=10
# UPLOAD_PATH=./uploads

# ===========================================
# LOGGING (Optional)
# ===========================================
# LOG_LEVEL=info
# LOG_FORMAT=json

# ===========================================
# PRODUCTION NOTES
# ===========================================
# 1. Change JWT_SECRET to a strong random value
# 2. Use proper SMTP credentials (Gmail App Password or SendGrid)
# 3. Set ALLOW_BOOTSTRAP_OVERRIDE=false
# 4. Use strong DATABASE_URL with complex password
# 5. Enable HTTPS in production (handled by Caddy)
# 6. Set proper FRONTEND_URL (your domain)
